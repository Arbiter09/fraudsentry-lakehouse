# Copy to governance/openlineage.env (gitignored) and source it before
# running `dbt build` or the Dagster daemon, so both emit lineage events
# to the same OpenLineage-compatible backend (DataHub's GMS accepts the
# OpenLineage REST API on this path).

OPENLINEAGE_URL=http://localhost:8080/openapi
OPENLINEAGE_NAMESPACE=fraudsentry

# dbt-ol (the OpenLineage dbt wrapper) reads these too -- run
# `dbt-ol build` instead of `dbt build` from dbt/fraudsentry_dbt/ so
# lineage events actually get emitted.
